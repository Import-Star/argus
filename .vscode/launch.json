{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Argus (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Run Argus + plugins (Extension Development Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/plugins/kanban",
        "--extensionDevelopmentPath=${workspaceFolder}/plugins/actions"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js", "${workspaceFolder}/plugins/*/out/**/*.js"],
      "preLaunchTask": "npm: compile all"
    }
  ]
}
